<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

    <!-- BarWardenBarTemplate: A single tracking bar (StatusBar with background, border, and icon frame).
         FontStrings and spark are created in Lua (Bar.lua) because StatusBar child FontStrings
         are not registered as globals in WoW 3.3.5a. -->
    <StatusBar name="BarWardenBarTemplate" virtual="true" minValue="0" maxValue="1" defaultValue="0">
        <Size x="200" y="20"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentBackground" setAllPoints="true">
                    <Color r="0" g="0" b="0" a="0.6"/>
                </Texture>
            </Layer>
            <Layer level="BORDER">
                <Texture name="$parentBorder" setAllPoints="true">
                    <Color r="0" g="0" b="0" a="0.8"/>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <Frame name="$parentIcon">
                <Size x="20" y="20"/>
                <Anchors>
                    <Anchor point="LEFT" x="1" y="0"/>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture name="$parentIconTexture" setAllPoints="true"/>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
    </StatusBar>

</Ui>
